# =============================================================================
# IMS Thailand — example environment file
# =============================================================================
# Copy this file to .env.development (committed) or .env.local (gitignored)
# and fill in real values. NEVER commit a file named .env.development with
# production-grade secrets.
#
# Required vs optional:
#   - Variables marked "REQUIRED" must be set in any non-development env.
#   - Defaults shown after the equals sign apply when the variable is unset.
# =============================================================================

# ─────────────────────────────────────────────────────────────────────────────
# Application
# ─────────────────────────────────────────────────────────────────────────────
APP_ENV=development                                # development | test | staging | production
APP_PORT=8080                                      # HTTP listen port
APP_LOG_LEVEL=debug                                # debug | info | warn | error
APP_JWT_SECRET=                                    # REQUIRED outside development. >= 32 random bytes, base64.
REPORTING_CURRENCY=THB                             # REQUIRED. ISO 4217 currency for official AUM/P&L reporting.

# ─────────────────────────────────────────────────────────────────────────────
# Database (PostgreSQL)
# ─────────────────────────────────────────────────────────────────────────────
DB_HOST=postgres
DB_PORT=5437
DB_NAME=ims_dev
DB_USER=ims_app
DB_PASSWORD=                                       # REQUIRED. Never commit a real password.
DB_SSL_MODE=disable                                # require | verify-full | disable (dev only)
DB_MAX_CONNECTIONS=25

# ─────────────────────────────────────────────────────────────────────────────
# Redis (rate limiting backend; optional)
# ─────────────────────────────────────────────────────────────────────────────
RATE_LIMIT_BACKEND=memory                          # memory | redis
REDIS_ADDR=redis:6379
REDIS_PASSWORD=
REDIS_DB=0

# ─────────────────────────────────────────────────────────────────────────────
# IAM
# ─────────────────────────────────────────────────────────────────────────────
MFA_ISSUER_NAME=IMS Thailand
MFA_ENCRYPTION_KEY=                                # REQUIRED outside development. 64-char hex (AES-256).
MFA_FORCED_FOR_ADMIN=false

# Session policy
SESSION_IDLE_TIMEOUT=30m
SESSION_ABSOLUTE_LIFE=24h
SESSION_MAX_CONCURRENT=0                           # 0 = unlimited
SESSION_CONCURRENT_MODE=evict_oldest               # evict_oldest | reject

# Account lockout
LOGIN_MAX_FAILED_ATTEMPTS=10
LOGIN_LOCKOUT_DURATION=30m

# JWT key rotation (optional)
APP_JWT_SECRET_PREVIOUS=
APP_JWT_KEY_ID=k1
APP_JWT_KEY_ID_PREVIOUS=prev

# Network controls
TRUSTED_PROXIES=                                   # comma-separated CIDRs of trusted reverse proxies
ADMIN_IP_ALLOWLIST=                                # comma-separated CIDRs allowed to hit /admin

# Rate limiting (defaults shown)
RATE_LIMIT_GLOBAL_PER_IP=200
RATE_LIMIT_GLOBAL_WINDOW=1m
RATE_LIMIT_LOGIN_PER_IP=20
RATE_LIMIT_LOGIN_PER_USER=5
RATE_LIMIT_LOGIN_WINDOW=1m
RATE_LIMIT_REFRESH_PER_IP=30
RATE_LIMIT_REFRESH_WINDOW=15m
RATE_LIMIT_SENSITIVE_MAX=5
RATE_LIMIT_SENSITIVE_WINDOW=15m
RATE_LIMIT_ADMIN_MAX=60
RATE_LIMIT_ADMIN_WINDOW=1m
RATE_LIMIT_EXPORT_MAX=5
RATE_LIMIT_EXPORT_WINDOW=1h

# ─────────────────────────────────────────────────────────────────────────────
# CORS
# ─────────────────────────────────────────────────────────────────────────────
CORS_ALLOWED_ORIGINS=                              # comma-separated. Empty = localhost dev defaults.

# ─────────────────────────────────────────────────────────────────────────────
# Frontend (consumed by Nuxt at build time)
# ─────────────────────────────────────────────────────────────────────────────
NUXT_PUBLIC_API_BASE_URL=http://localhost:8080/api/v1
NUXT_PUBLIC_APP_NAME=IMS Thailand

# ─────────────────────────────────────────────────────────────────────────────
# Market data — providers
# ─────────────────────────────────────────────────────────────────────────────
# MARKET_DATA_PROVIDER picks the primary live-quote provider for the
# Investment / Holdings dashboard. Honoured as an alias for
# MARKET_DATA_PRIMARY_PROVIDER so deployments can use either name.
#   alpha_vantage — uses ALPHA_VANTAGE_API_KEY below.
#   yahoo         — no API key needed; unofficial fallback.
#   twelve_data   — uses TWELVE_DATA_API_KEY (client not wired yet).
#   mock          — local tests / CI only; never use in production.
MARKET_DATA_PROVIDER=alpha_vantage
MARKET_DATA_PRIMARY_PROVIDER=alpha_vantage
MARKET_DATA_FALLBACK_PROVIDER=yahoo

# Operator-facing timeout for a single provider call. MARKET_DATA_TIMEOUT_MS
# wins when set; otherwise the legacy MARKET_DATA_HTTP_TIMEOUT_SECONDS applies.
MARKET_DATA_TIMEOUT_MS=15000
MARKET_DATA_HTTP_TIMEOUT_SECONDS=15

# Cache TTL applied to the live-quote read path (seconds).
MARKET_DATA_CACHE_TTL_SECONDS=900

# Holdings page: when a quote is older than this, surface the stale badge.
MARKET_DATA_STALE_AFTER_MINUTES=15

# Hint to operators / scheduler for how often to refresh prices. The
# investment intraday valuation service exposes this on its status endpoint
# so the UI can adapt its poll cadence.
MARKET_DATA_REFRESH_INTERVAL_MINUTES=15

# Alpha Vantage credentials + tuning.
ALPHA_VANTAGE_API_KEY=                             # REQUIRED outside development/test. Treat as a credential.
ALPHA_VANTAGE_RATE_LIMIT_PER_MIN=5                 # Free tier = 5/min.
ALPHA_VANTAGE_RATE_LIMIT_PER_DAY=500               # Free tier = 500/day.
ALPHA_VANTAGE_BASE_URL=https://www.alphavantage.co
ALPHA_VANTAGE_TIMEOUT=30s

# Twelve Data — accepted by config for forward compatibility; no client wired.
TWELVE_DATA_API_KEY=

# ─────────────────────────────────────────────────────────────────────────────
# Market data — ingestion scheduler
# ─────────────────────────────────────────────────────────────────────────────
INGESTION_SCHEDULE_CRON=0 18 * * 1-5               # Default: 18:00 weekdays (Asia/Bangkok configured at runtime).

# ─────────────────────────────────────────────────────────────────────────────
# Investment — valuation staleness thresholds
# ─────────────────────────────────────────────────────────────────────────────
# Comma-separated CODE=DURATION pairs. Codes are investment__asset_classes.
# Inputs older than the threshold trigger investment_valuation_stale_inputs_total
# and surface as stale on the snapshot.
VALUATION_STALE_THRESHOLDS=EQUITY=24h,FIXED_INCOME=72h,FUND=24h,ETF=24h,CASH=720h,ALTERNATIVE=720h,DERIVATIVE=24h

# ─────────────────────────────────────────────────────────────────────────────
# Chat / LLM provider
# ─────────────────────────────────────────────────────────────────────────────
# LLM_PROVIDER selects the active adapter. Slice A only ships "anthropic";
# Slice B will accept openai | gemini | openai_compatible behind the same
# ChatProvider interface (no code change at the call site).
LLM_PROVIDER=anthropic                             # anthropic | openai | gemini | openai_compatible
ANTHROPIC_API_KEY=                               # REQUIRED when LLM_PROVIDER=anthropic. Empty → /chat is not mounted.
ANTHROPIC_MODEL=claude-haiku-4-5-20251001          # any current Anthropic Messages-API model id
CHAT_MAX_TOKENS_PER_TURN=1024                      # provider max_tokens budget per assistant turn
