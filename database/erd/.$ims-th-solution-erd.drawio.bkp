OT NULL&lt;/div&gt;&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#047857;strokeWidth=2;arcSize=6;shadow=1;align=left;verticalAlign=top;" vertex="1" parent="1">
