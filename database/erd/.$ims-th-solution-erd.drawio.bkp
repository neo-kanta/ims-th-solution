  <diagram id="ims_p01" name="01 - IAM + Permissions">
    <mxGraphModel dx="1600" dy="1000" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2600" pageHeight="1500" math="0" shadow="0" background="#F8FAFC">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="p01_header" value="&lt;div style=&quot;padding:8px 18px;&quot;&gt;&lt;div style=&quot;font-size:28px;font-weight:800;color:#0F172A;&quot;&gt;01 - IAM + Permissions&lt;/div&gt;&lt;div style=&quot;font-size:13px;color:#475569;margin-top:4px;&quot;&gt;Identity, sessions, MFA, audit trail, RBAC groups, function catalog, and data grants.&lt;/div&gt;&lt;/div&gt;" style="text;html=1;strokeColor=none;fillColor=#FFFFFF;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=1;arcSize=4;shadow=0;" vertex="1" parent="1">
          <mxGeometry x="40" y="28" width="2520" height="82" as="geometry" />
        </mxCell>
        <mxCell id="p01_note" value="&lt;div style=&quot;padding:10px 13px;&quot;&gt;&lt;div style=&quot;font-size:15px;font-weight:700;color:#B45309;margin-bottom:6px;&quot;&gt;Senior Engineer Note&lt;/div&gt;&lt;div style=&quot;font-size:11px;line-height:1.55;color:#334155;&quot;&gt;iam_users has soft delete, but username uniqueness is still a full table constraint, so a deleted username is not reusable without schema change.&lt;/div&gt;&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFBEB;strokeColor=#B45309;strokeWidth=1.5;arcSize=7;shadow=0;align=left;verticalAlign=top;" vertex="1" parent="1">
          <mxGeometry x="60" y="126" width="2480" height="86" as="geometry" />
        </mxCell>
        <mxCell id="p01_iam_users" value="&lt;div style=&quot;background:#4F46E5;color:#FFFFFF;padding:7px 9px;font-weight:700;font-size:13px;&quot;&gt;iam_users &lt;span style=&quot;font-size:9px;font-weight:600;&quot;&gt;[SOFT LOCK]&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;font-family:Consolas,monospace;font-size:10px;line-height:1.45;text-align:left;padding:7px 9px;color:#1E293B;&quot;&gt;&lt;div&gt;PK id uuid&lt;/div&gt;&lt;div&gt;UQ NN username varchar(100)&lt;/div&gt;&lt;div&gt;NN display_name varchar(255)&lt;/div&gt;&lt;div&gt;email varchar(255)&lt;/div&gt;&lt;div&gt;NN password_hash varchar(255)&lt;/div&gt;&lt;div&gt;NN is_active bool&lt;/div&gt;&lt;div&gt;NN force_password_change bool&lt;/div&gt;&lt;div&gt;NN failed_login_attempts int&lt;/div&gt;&lt;div&gt;locked_until timestamptz&lt;/div&gt;&lt;div&gt;last_login_at timestamptz&lt;/div&gt;&lt;div&gt;NN version int&lt;/div&gt;&lt;div&gt;NN created_at timestamptz&lt;/div&gt;&lt;div&gt;NN updated_at timestamptz&lt;/div&gt;&lt;div&gt;created_by uuid&lt;/div&gt;&lt;div&gt;updated_by uuid&lt;/div&gt;&lt;div&gt;deleted_at timestamptz&lt;/div&gt;&lt;div&gt;password_changed_at timestamptz&lt;/div&gt;&lt;div&gt;UQ (username)&lt;/div&gt;&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#3730A3;strokeWidth=2;arcSize=6;shadow=1;align=left;verticalAlign=top;" vertex="1" parent="1">
