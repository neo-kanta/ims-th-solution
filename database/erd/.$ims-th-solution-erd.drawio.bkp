  <diagram id="ims_p06" name="06 - Market Data">
    <mxGraphModel dx="1600" dy="1000" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2600" pageHeight="1500" math="0" shadow="0" background="#F8FAFC">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="p06_header" value="&lt;div style=&quot;padding:8px 18px;&quot;&gt;&lt;div style=&quot;font-size:28px;font-weight:800;color:#0F172A;&quot;&gt;06 - Market Data&lt;/div&gt;&lt;div style=&quot;font-size:13px;color:#475569;margin-top:4px;&quot;&gt;Provider symbol mapping, price/quote snapshots, and provider request observability.&lt;/div&gt;&lt;/div&gt;" style="text;html=1;strokeColor=none;fillColor=#FFFFFF;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=1;arcSize=4;shadow=0;" vertex="1" parent="1">
          <mxGeometry x="40" y="28" width="2520" height="82" as="geometry" />
        </mxCell>
        <mxCell id="p06_note" value="&lt;div style=&quot;padding:10px 13px;&quot;&gt;&lt;div style=&quot;font-size:15px;font-weight:700;color:#B45309;margin-bottom:6px;&quot;&gt;Senior Engineer Note&lt;/div&gt;&lt;div style=&quot;font-size:11px;line-height:1.55;color:#334155;&quot;&gt;Market data is intentionally provider/symbol oriented and has no FK to the investment instrument master. Reconciliation belongs in service logic.&lt;/div&gt;&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFBEB;strokeColor=#B45309;strokeWidth=1.5;arcSize=7;shadow=0;align=left;verticalAlign=top;" vertex="1" parent="1">
          <mxGeometry x="60" y="126" width="2480" height="86" as="geometry" />
        </mxCell>
        <mxCell id="p06_market_symbols" value="&lt;div style=&quot;background:#0891B2;color:#FFFFFF;padding:7px 9px;font-weight:700;font-size:13px;&quot;&gt;market_symbols&lt;/div&gt;&lt;div style=&quot;font-family:Consolas,monospace;font-size:10px;line-height:1.45;text-align:left;padding:7px 9px;color:#1E293B;&quot;&gt;&lt;div&gt;PK id uuid&lt;/div&gt;&lt;div&gt;UQ NN symbol varchar(64)&lt;/div&gt;&lt;div&gt;NN asset_type varchar(20)&lt;/div&gt;&lt;div&gt;name text&lt;/div&gt;&lt;div&gt;currency char(3)&lt;/div&gt;&lt;div&gt;alpha_vantage_symbol varchar(64)&lt;/div&gt;&lt;div&gt;yahoo_symbol varchar(64)&lt;/div&gt;&lt;div&gt;NN is_active bool&lt;/div&gt;&lt;div&gt;NN created_at timestamptz&lt;/div&gt;&lt;div&gt;NN updated_at timestamptz&lt;/div&gt;&lt;div&gt;UQ (symbol)&lt;/div&gt;&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#0E7490;strokeWidth=2;arcSize=6;shadow=1;align=left;verticalAlign=top;" vertex="1" parent="1">
          <mxGeometry x="60" y="246" width="420" height="246" as="geometry" />
        </mxCell>
        <mxCell id="p06_market_data_snapshots" value="&lt;div style=&quot;background:#0891B2;color:#FFFFFF;padding:7px 9px;font-weight:700;font-size:13px;&quot;&gt;market_data_snapshots&lt;/div&gt;&lt;div style=&quot;font-family:Consolas,monospace;font-size:10px;line-height:1.45;text-align:left;padding:7px 9px;color:#1E293B;&quot;&gt;&lt;div&gt;PK id uuid&lt;/div&gt;&lt;div&gt;FK NN symbol_id uuid -&amp;gt; market_symbols.id&lt;/div&gt;&lt;div&gt;NN provider_name varchar(40)&lt;/div&gt;&lt;div&gt;NN data_type varchar(10)&lt;/div&gt;&lt;div&gt;NN price_date date&lt;/div&gt;&lt;div&gt;NN as_of timestamptz&lt;/div&gt;&lt;div&gt;NN price decimal(28,8)&lt;/div&gt;&lt;div&gt;open_price decimal(28,8)&lt;/div&gt;&lt;div&gt;high_price decimal(28,8)&lt;/div&gt;&lt;div&gt;low_price decimal(28,8)&lt;/div&gt;&lt;div&gt;NN close_price decimal(28,8)&lt;/div&gt;&lt;div&gt;adjusted_close decimal(28,8)&lt;/div&gt;&lt;div&gt;previous_close decimal(28,8)&lt;/div&gt;&lt;div&gt;change_amount decimal(28,8)&lt;/div&gt;&lt;div&gt;change_percent decimal(18,8)&lt;/div&gt;&lt;div&gt;volume bigint&lt;/div&gt;&lt;div&gt;currency char(3)&lt;/div&gt;&lt;div&gt;NN raw_payload jsonb&lt;/div&gt;&lt;div&gt;NN captured_at timestamptz&lt;/div&gt;&lt;div&gt;UQ IDX (symbol_id, provider_name, data_type, price_date)&lt;/div&gt;&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#0E7490;strokeWidth=2;arcSize=6;shadow=1;align=left;verticalAlign=top;" vertex="1" parent="1">
          <mxGeometry x="514" y="246" width="420" height="408" as="geometry" />
        </mxCell>
        <mxCell id="p06_provider_requests_log" value="&lt;div style=&quot;background:#0891B2;color:#FFFFFF;padding:7px 9px;font-weight:700;font-size:13px;&quot;&gt;provider_requests_log&lt;/div&gt;&lt;div style=&quot;font-family:Consolas,monospace;font-size:10px;line-height:1.45;text-align:left;padding:7px 9px;color:#1E293B;&quot;&gt;&lt;div&gt;PK id uuid&lt;/div&gt;&lt;div&gt;NN provider_name varchar(40)&lt;/div&gt;&lt;div&gt;NN symbol varchar(64)&lt;/div&gt;&lt;div&gt;NN operation varchar(20)&lt;/div&gt;&lt;div&gt;NN status varchar(20)&lt;/div&gt;&lt;div&gt;status_code int&lt;/div&gt;&lt;div&gt;error_code varchar(80)&lt;/div&gt;&lt;div&gt;error_message text&lt;/div&gt;&lt;div&gt;NN duration_ms int&lt;/div&gt;&lt;div&gt;NN requested_at timestamptz&lt;/div&gt;&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#0E7490;strokeWidth=2;arcSize=6;shadow=1;align=left;verticalAlign=top;" vertex="1" parent="1">
          <mxGeometry x="968" y="246" width="420" height="228" as="geometry" />
        </mxCell>
        <mxCell id="p06_fk_0" value="symbol_id" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#475569;strokeWidth=1.6;fontSize=10;fontColor=#334155;" edge="1" parent="1" source="p06_market_data_snapshots" target="p06_market_symbols">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram id="ims_critical" name="07 - Critical Notes">
    <mxGraphModel dx="1600" dy="1000" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2600" pageHeight="1900" math="0" shadow="0" background="#F8FAFC">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="critical_header" value="&lt;div style=&quot;padding:8px 18px;&quot;&gt;&lt;div style=&quot;font-size:28px;font-weight:800;color:#0F172A;&quot;&gt;Critical Analysis&lt;/div&gt;&lt;div style=&quot;font-size:13px;color:#475569;margin-top:4px;&quot;&gt;Operational and modeling details that are easy to miss when reading only table names.&lt;/div&gt;&lt;/div&gt;" style="text;html=1;strokeColor=none;fillColor=#FFFFFF;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=1;arcSize=4;shadow=0;" vertex="1" parent="1">
          <mxGeometry x="40" y="28" width="2520" height="82" as="geometry" />
        </mxCell>
        <mxCell id="critical_note_0" value="&lt;div style=&quot;padding:10px 13px;&quot;&gt;&lt;div style=&quot;font-size:15px;font-weight:700;color:#B45309;margin-bottom:6px;&quot;&gt;1. Fund.id is the contract_id&lt;/div&gt;&lt;div style=&quot;font-size:11px;line-height:1.55;color:#334155;&quot;&gt;investment__funds.id is the cross-module contract key used by workflow, compliance, scheduler, and permissions data rights. Most of those links are intentionally not declared as FKs to keep module boundaries loose.&lt;/div&gt;&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFBEB;strokeColor=#B45309;strokeWidth=1.5;arcSize=7;shadow=0;align=left;verticalAlign=top;" vertex="1" parent="1">
          <mxGeometry x="60" y="145" width="1180" height="154" as="geometry" />
        </mxCell>
        <mxCell id="critical_note_1" value="&lt;div style=&quot;padding:10px 13px;&quot;&gt;&lt;div style=&quot;font-size:15px;font-weight:700;color:#B45309;margin-bottom:6px;&quot;&gt;2. Soft delete is not uniform&lt;/div&gt;&lt;div style=&quot;font-size:11px;line-height:1.55;color:#334155;&quot;&gt;funds, portfolios, instruments, and research reports use partial unique indexes with deleted_at IS NULL. iam_users and permissions_groups still have full unique constraints, so soft-deleted usernames/group names cannot be reused without a migration.&lt;/div&gt;&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFBEB;strokeColor=#B45309;strokeWidth=1.5;arcSize=7;shadow=0;align=left;verticalAlign=top;" vertex="1" parent="1">
          <mxGeometry x="1280" y="145" width="1180" height="154" as="geometry" />
        </mxCell>
        <mxCell id="critical_note_2" value="&lt;div style=&quot;padding:10px 13px;&quot;&gt;&lt;div style=&quot;font-size:15px;font-weight:700;color:#B45309;margin-bottom:6px;&quot;&gt;3. Append-only enforcement differs by module&lt;/div&gt;&lt;div style=&quot;font-size:11px;line-height:1.55;color:#334155;&quot;&gt;investment ledger/snapshot tables use rejecting triggers. iam_audit_events uses rejecting triggers. compliance_check_records and compliance_overrides rely on privilege revokes, which do not stop the table owner. workflow transition_log is append-only by design comments, but not enforced by a DB trigger today.&lt;/div&gt;&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFBEB;strokeColor=#B45309;strokeWidth=1.5;arcSize=7;shadow=0;align=left;verticalAlign=top;" vertex="1" parent="1">
          <mxGeometry x="60" y="327" width="1180" height="154" as="geometry" />
        </mxCell>
        <mxCell id="critical_note_3" value="&lt;div style=&quot;padding:10px 13px;&quot;&gt;&lt;div style=&quot;font-size:15px;font-weight:700;color:#B45309;margin-bottom:6px;&quot;&gt;4. Polymorphic scope columns need application validation&lt;/div&gt;&lt;div style=&quot;font-size:11px;line-height:1.55;color:#334155;&quot;&gt;scope_type/scope_id appears in compliance bindings, workflow settings/rules, investment process assignments, and AUM snapshots. The database cannot enforce these conditional references directly.&lt;/div&gt;&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFBEB;strokeColor=#B45309;strokeWidth=1.5;arcSize=7;shadow=0;align=left;verticalAlign=top;" vertex="1" parent="1">
          <mxGeometry x="1280" y="327" width="1180" height="154" as="geometry" />
        </mxCell>
        <mxCell id="critical_note_4" value="&lt;div style=&quot;padding:10px 13px;&quot;&gt;&lt;div style=&quot;font-size:15px;font-weight:700;color:#B45309;margin-bottom:6px;&quot;&gt;5. Research reports are deliberately loose in PoC scope&lt;/div&gt;&lt;div style=&quot;font-size:11px;line-height:1.55;color:#334155;&quot;&gt;owner_user_id, author_user_id, applicable_contract_id, and instrument_code have no FKs yet. This keeps the feature scaffold flexible, but it allows orphaned user/contract/instrument references.&lt;/div&gt;&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFBEB;strokeColor=#B45309;strokeWidth=1.5;arcSize=7;shadow=0;align=left;verticalAlign=top;" vertex="1" parent="1">
          <mxGeometry x="60" y="509" width="1180" height="154" as="geometry" />
        </mxCell>
        <mxCell id="critical_note_5" value="&lt;div style=&quot;padding:10px 13px;&quot;&gt;&lt;div style=&quot;font-size:15px;font-weight:700;color:#B45309;margin-bottom:6px;&quot;&gt;6. Permissions data rights has a type mismatch&lt;/div&gt;&lt;div style=&quot;font-size:11px;line-height:1.55;color:#334155;&quot;&gt;permissions_data_rights.contract_id is VARCHAR(50), while the investment contract key is investment__funds.id UUID. This is likely legacy or an integration boundary, and should be revisited before hard FK enforcement.&lt;/div&gt;&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFBEB;strokeColor=#B45309;strokeWidth=1.5;arcSize=7;shadow=0;align=left;verticalAlign=top;" vertex="1" parent="1">
          <mxGeometry x="1280" y="509" width="1180" height="154" as="geometry" />
        </mxCell>
        <mxCell id="critical_note_6" value="&lt;div style=&quot;padding:10px 13px;&quot;&gt;&lt;div style=&quot;font-size:15px;font-weight:700;color:#B45309;margin-bottom:6px;&quot;&gt;7. Market data is symbol-driven&lt;/div&gt;&lt;div style=&quot;font-size:11px;line-height:1.55;color:#334155;&quot;&gt;market_symbols and market_data_snapshots are not linked to investment__instruments. Mapping is by ticker/provider symbols, so reconciliation logic must handle mismatches and provider aliases.&lt;/div&gt;&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFBEB;strokeColor=#B45309;strokeWidth=1.5;arcSize=7;shadow=0;align=left;verticalAlign=top;" vertex="1" parent="1">
          <mxGeometry x="60" y="691" width="1180" height="154" as="geometry" />
        </mxCell>
        <mxCell id="critical_note_7" value="&lt;div style=&quot;padding:10px 13px;&quot;&gt;&lt;div style=&quot;font-size:15px;font-weight:700;color:#B45309;margin-bottom:6px;&quot;&gt;8. JSONB carries important domain state&lt;/div&gt;&lt;div style=&quot;font-size:11px;line-height:1.55;color:#334155;&quot;&gt;instrument attributes, compliance parameters/evidence/snapshots, workflow metadata, and market raw_payload are JSONB. They are flexible, but they move some schema guarantees from DB constraints into code/tests.&lt;/div&gt;&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFBEB;strokeColor=#B45309;strokeWidth=1.5;arcSize=7;shadow=0;align=left;verticalAlign=top;" vertex="1" parent="1">
          <mxGeometry x="1280" y="691" width="1180" height="154" as="geometry" />
        </mxCell>
        <mxCell id="critical_note_8" value="&lt;div style=&quot;padding:10px 13px;&quot;&gt;&lt;div style=&quot;font-size:15px;font-weight:700;color:#B45309;margin-bottom:6px;&quot;&gt;9. Optimistic locking marks mutable projections&lt;/div&gt;&lt;div style=&quot;font-size:11px;line-height:1.55;color:#334155;&quot;&gt;version columns appear on users, funds, portfolios, day_states, portfolio_positions, and cash_balances. These are mutable current-state projections and should update with compare-and-increment semantics.&lt;/div&gt;&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFBEB;strokeColor=#B45309;strokeWidth=1.5;arcSize=7;shadow=0;align=left;verticalAlign=top;" vertex="1" parent="1">
          <mxGeometry x="60" y="873" width="1180" height="154" as="geometry" />
        </mxCell>
        <mxCell id="critical_note_9" value="&lt;div style=&quot;padding:10px 13px;&quot;&gt;&lt;div style=&quot;font-size:15px;font-weight:700;color:#B45309;margin-bottom:6px;&quot;&gt;10. Rule versioning preserves reproducibility&lt;/div&gt;&lt;div style=&quot;font-size:11px;line-height:1.55;color:#334155;&quot;&gt;compliance_rule_instances points at the current version, while check records pin rule_instance_version and parameter_snapshot. Historical compliance decisions should be replayable against the exact parameters used.&lt;/div&gt;&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFBEB;strokeColor=#B45309;strokeWidth=1.5;arcSize=7;shadow=0;align=left;verticalAlign=top;" vertex="1" parent="1">
          <mxGeometry x="1280" y="873" width="1180" height="154" as="geometry" />
        </mxCell>
        <mxCell id="critical_inventory" value="&lt;div style=&quot;padding:14px 18px;&quot;&gt;&lt;div style=&quot;font-size:17px;font-weight:800;color:#0F172A;margin-bottom:8px;&quot;&gt;Inventory&lt;/div&gt;&lt;div style=&quot;font-family:Consolas,monospace;font-size:12px;line-height:1.7;color:#334155;&quot;&gt;Total tables: 58&lt;br/&gt;IAM: 7&lt;br/&gt;Permissions: 5&lt;br/&gt;Workflow: 9&lt;br/&gt;Compliance: 9&lt;br/&gt;Investment: 25&lt;br/&gt;Market data: 3&lt;br/&gt;Migration files parsed: 26&lt;/div&gt;&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#CBD5E1;strokeWidth=1.5;arcSize=7;shadow=1;align=left;verticalAlign=top;" vertex="1" parent="1">
          <mxGeometry x="60" y="1560" width="1180" height="220" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
