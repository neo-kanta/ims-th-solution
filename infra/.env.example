# =============================================================================
# infra/.env — local-only secrets for docker-compose (GITIGNORED)
# =============================================================================
# Copy this file to infra/.env and fill in real values. docker-compose
# automatically loads infra/.env (the file sitting next to docker-compose.yml)
# and uses it for ${VAR} interpolation in the compose file.
#
# This is where the chat/LLM API key goes for the Docker stack — NOT in
# env/.env.development, which is committed to git. infra/.env matches the
# repo .gitignore ".env" rule, so it is never committed.
# =============================================================================

# Active LLM provider. Slice A supports "anthropic" only.
LLM_PROVIDER=anthropic

# Anthropic API key from console.anthropic.com (format: sk-ant-...).
# Empty → chat module stays disabled; the rest of the API still runs.
ANTHROPIC_API_KEY=

# Any current Anthropic Messages-API model id.
ANTHROPIC_MODEL=claude-haiku-4-5-20251001

# Provider max_tokens budget per assistant turn.
CHAT_MAX_TOKENS_PER_TURN=1024
