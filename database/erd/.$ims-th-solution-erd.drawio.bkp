        <mxCell id="overview_market_data_snapshots" value="&lt;div style=&quot;background:#0891B2;color:#FFFFFF;padding:7px 9px;font-weight:700;font-size:13px;&quot;&gt;market_data_snapshots&lt;/div&gt;&lt;div style=&quot;font-family:Consolas,monospace;font-size:10px;line-height:1.45;text-align:left;padding:7px 9px;color:#1E293B;&quot;&gt;&lt;div&gt;PK id uuid&lt;/div&gt;&lt;div&gt;FK NN symbol_id uuid -&amp;gt; market_symbols.id&lt;/div&gt;&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#0E7490;strokeWidth=2;arcSize=6;shadow=1;align=left;verticalAlign=top;" vertex="1" parent="1">
          <mxGeometry x="3140" y="1288" width="250" height="116" as="geometry" />
        </mxCell>
        <mxCell id="overview_market_symbols" value="&lt;div style=&quot;background:#0891B2;color:#FFFFFF;padding:7px 9px;font-weight:700;font-size:13px;&quot;&gt;market_symbols&lt;/div&gt;&lt;div style=&quot;font-family:Consolas,monospace;font-size:10px;line-height:1.45;text-align:left;padding:7px 9px;color:#1E293B;&quot;&gt;&lt;div&gt;PK id uuid&lt;/div&gt;&lt;div&gt;UQ NN symbol varchar(64)&lt;/div&gt;&lt;div&gt;name text&lt;/div&gt;&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#0E7490;strokeWidth=2;arcSize=6;shadow=1;align=left;verticalAlign=top;" vertex="1" parent="1">
